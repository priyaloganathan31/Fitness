# ==============================================================================
# DEPLOYMENT ENVIRONMENT VARIABLES (Frontend: Vercel | Backend: Render)
# ==============================================================================

# [BACKEND - RENDER]
# ------------------------------------------------------------------------------
# The port the Express backend runs on. Render will usually inject this automatically.
PORT=5000

# Your MongoDB Atlas Connection String.
# Replace `<username>`, `<password>`, and `<cluster-url>` with your actual credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# [FRONTEND - VERCEL]
# ------------------------------------------------------------------------------
# The base URL of the backend API.
# In local dev: http://localhost:5000/api
# In production (Vercel): Do NOT set this variable, or set it to '/api'. 
# Vercel uses `vercel.json` to proxy `/api` directly to your Render backend automatically.
VITE_API_BASE_URL=http://localhost:5000/api
